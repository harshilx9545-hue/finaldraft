# Copy to .env.local for local development.
#
# The backend serves its API under /api and its CORS_ALLOWED_ORIGINS default admits
# only http://localhost:3000 and http://127.0.0.1:3000, which is why the dev server
# is pinned to port 3000.
#
# There are no secrets here. The Razorpay key_id the checkout needs is public and
# arrives at runtime in the pay-order response, never from build config.
VITE_API_BASE_URL=http://localhost:8000/api
